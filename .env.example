# Supabase (Project Settings → API). Sem estas variáveis o site roda em modo demonstração
# lendo src/data/catalog.json e os pedidos vão direto para o WhatsApp.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# URL pública do site (usada nos links de acompanhamento enviados pelo WhatsApp)
NEXT_PUBLIC_SITE_URL=https://catalogo.atelierdacarne.com.br
